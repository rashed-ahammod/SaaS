{
  "id": "erpNotifications01",
  "name": "ERP notifications (approval nudges, payslip delivery, attendance digest)",
  "active": false,
  "isArchived": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": false
  },
  "pinData": {},
  "tags": [],
  "meta": {
    "description": "Every ERP outbox event arrives here (POST <base>/<event type>). The core decides who gets which message; this workflow only checks the signature, claims the event's e-mail / SMS messages with the event's callback token, sends them (SMS: primary gateway, then fallback), and reports each result. Claiming hands out only messages not yet sent, so a replayed event sends nothing twice."
  },
  "nodes": [
    {
      "id": "b3f3d0a4-0001-4000-8000-000000000001",
      "name": "ERP event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 300],
      "webhookId": "6f1c2b9e-3d4a-4f5b-9c7d-8e0f1a2b3c4d",
      "parameters": {
        "httpMethod": "POST",
        "path": "erp/:eventType",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "b3f3d0a4-0002-4000-8000-000000000002",
      "name": "Signature",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [220, 300],
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.headers['x-timestamp'] + '.' + JSON.stringify($json.body) }}",
        "dataPropertyName": "expectedSignature",
        "encoding": "hex"
      },
      "credentials": {
        "crypto": { "id": "erpWebhookSecret", "name": "ERP webhook secret" }
      }
    },
    {
      "id": "b3f3d0a4-0003-4000-8000-000000000003",
      "name": "Signed and fresh?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.expectedSignature === $json.headers['x-signature'] && Math.abs($now.toUnixInteger() - Number($json.headers['x-timestamp'])) <= 300 && !!$json.headers['x-callback-token'] }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b3f3d0a4-0004-4000-8000-000000000004",
      "name": "Rejected (bad signature)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [660, 480],
      "parameters": {}
    },
    {
      "id": "b3f3d0a4-0005-4000-8000-000000000005",
      "name": "Claim messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 280],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ERP_API_URL }}/notifications/events/{{ $('ERP event').item.json.body.id }}/claim",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=EventToken {{ $('ERP event').item.json.headers['x-callback-token'] }}" }]
        },
        "options": {}
      }
    },
    {
      "id": "b3f3d0a4-0006-4000-8000-000000000006",
      "name": "One item per message",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [880, 280],
      "parameters": {
        "fieldToSplitOut": "messages",
        "options": {}
      }
    },
    {
      "id": "b3f3d0a4-0007-4000-8000-000000000007",
      "name": "Channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [1100, 280],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
                "conditions": [{ "id": "email", "leftValue": "={{ $json.channel }}", "rightValue": "email", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "email"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
                "conditions": [{ "id": "sms", "leftValue": "={{ $json.channel }}", "rightValue": "sms", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "sms"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b3f3d0a4-0008-4000-8000-000000000008",
      "name": "Payslip attached?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1320, 120],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            { "id": "att", "leftValue": "={{ !!$json.attachment }}", "rightValue": "", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b3f3d0a4-0009-4000-8000-000000000009",
      "name": "Download payslip PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 20],
      "parameters": {
        "url": "={{ $env.ERP_API_URL }}{{ $json.attachment.path }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=EventToken {{ $('ERP event').first().json.headers['x-callback-token'] }}" }]
        },
        "options": {
          "response": { "response": { "responseFormat": "file", "outputPropertyName": "attachment" } }
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "b3f3d0a4-0010-4000-8000-000000000010",
      "name": "Send e-mail with PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, 20],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EMAIL_API_URL }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "name": "to", "value": "={{ $('One item per message').item.json.to }}" },
            { "name": "subject", "value": "={{ $('One item per message').item.json.subject }}" },
            { "name": "text", "value": "={{ $('One item per message').item.json.text }}" },
            { "parameterType": "formBinaryData", "name": "attachment", "inputDataFieldName": "attachment" }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "erpEmailApi", "name": "E-mail API" }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "b3f3d0a4-0011-4000-8000-000000000011",
      "name": "Send e-mail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, 220],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EMAIL_API_URL }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "name": "to", "value": "={{ $('One item per message').item.json.to }}" },
            { "name": "subject", "value": "={{ $('One item per message').item.json.subject }}" },
            { "name": "text", "value": "={{ $('One item per message').item.json.text }}" }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "erpEmailApi", "name": "E-mail API" }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "b3f3d0a4-0012-4000-8000-000000000012",
      "name": "SMS primary gateway",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 440],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SMS_PRIMARY_URL }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $json.to, text: $json.text, reference: $json.id }) }}",
        "options": { "timeout": 15000 }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "erpSmsPrimary", "name": "SMS gateway (primary)" }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "b3f3d0a4-0013-4000-8000-000000000013",
      "name": "SMS fallback gateway",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 560],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SMS_FALLBACK_URL }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $('One item per message').item.json.to, text: $('One item per message').item.json.text, reference: $('One item per message').item.json.id }) }}",
        "options": { "timeout": 15000 }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "erpSmsFallback", "name": "SMS gateway (fallback)" }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "b3f3d0a4-0014-4000-8000-000000000014",
      "name": "Report e-mail sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, 120],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ERP_API_URL }}/notifications/{{ $('One item per message').item.json.id }}/result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=EventToken {{ $('ERP event').first().json.headers['x-callback-token'] }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'sent', provider: 'email', providerMessageId: String($json.id ?? $json.messageId ?? '') }) }}",
        "options": {}
      }
    },
    {
      "id": "b3f3d0a4-0015-4000-8000-000000000015",
      "name": "Report e-mail failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ERP_API_URL }}/notifications/{{ $('One item per message').item.json.id }}/result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=EventToken {{ $('ERP event').first().json.headers['x-callback-token'] }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'failed', provider: 'email', error: String($json.error?.message ?? $json.error ?? 'e-mail API refused').slice(0, 900) }) }}",
        "options": {}
      }
    },
    {
      "id": "b3f3d0a4-0016-4000-8000-000000000016",
      "name": "Report SMS sent (primary)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, 400],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ERP_API_URL }}/notifications/{{ $('One item per message').item.json.id }}/result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=EventToken {{ $('ERP event').first().json.headers['x-callback-token'] }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'sent', provider: 'sms-primary', providerMessageId: String($json.id ?? $json.messageId ?? '') }) }}",
        "options": {}
      }
    },
    {
      "id": "b3f3d0a4-0017-4000-8000-000000000017",
      "name": "Report SMS sent (fallback)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, 560],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ERP_API_URL }}/notifications/{{ $('One item per message').item.json.id }}/result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=EventToken {{ $('ERP event').first().json.headers['x-callback-token'] }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'sent', provider: 'sms-fallback', providerMessageId: String($json.id ?? $json.messageId ?? '') }) }}",
        "options": {}
      }
    },
    {
      "id": "b3f3d0a4-0018-4000-8000-000000000018",
      "name": "Report SMS failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, 720],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ERP_API_URL }}/notifications/{{ $('One item per message').item.json.id }}/result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=EventToken {{ $('ERP event').first().json.headers['x-callback-token'] }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'failed', provider: 'sms-primary+sms-fallback', error: 'both SMS gateways refused' }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "ERP event": { "main": [[{ "node": "Signature", "type": "main", "index": 0 }]] },
    "Signature": { "main": [[{ "node": "Signed and fresh?", "type": "main", "index": 0 }]] },
    "Signed and fresh?": {
      "main": [
        [{ "node": "Claim messages", "type": "main", "index": 0 }],
        [{ "node": "Rejected (bad signature)", "type": "main", "index": 0 }]
      ]
    },
    "Claim messages": { "main": [[{ "node": "One item per message", "type": "main", "index": 0 }]] },
    "One item per message": { "main": [[{ "node": "Channel", "type": "main", "index": 0 }]] },
    "Channel": {
      "main": [
        [{ "node": "Payslip attached?", "type": "main", "index": 0 }],
        [{ "node": "SMS primary gateway", "type": "main", "index": 0 }]
      ]
    },
    "Payslip attached?": {
      "main": [
        [{ "node": "Download payslip PDF", "type": "main", "index": 0 }],
        [{ "node": "Send e-mail", "type": "main", "index": 0 }]
      ]
    },
    "Download payslip PDF": {
      "main": [
        [{ "node": "Send e-mail with PDF", "type": "main", "index": 0 }],
        [{ "node": "Report e-mail failed", "type": "main", "index": 0 }]
      ]
    },
    "Send e-mail with PDF": {
      "main": [
        [{ "node": "Report e-mail sent", "type": "main", "index": 0 }],
        [{ "node": "Report e-mail failed", "type": "main", "index": 0 }]
      ]
    },
    "Send e-mail": {
      "main": [
        [{ "node": "Report e-mail sent", "type": "main", "index": 0 }],
        [{ "node": "Report e-mail failed", "type": "main", "index": 0 }]
      ]
    },
    "SMS primary gateway": {
      "main": [
        [{ "node": "Report SMS sent (primary)", "type": "main", "index": 0 }],
        [{ "node": "SMS fallback gateway", "type": "main", "index": 0 }]
      ]
    },
    "SMS fallback gateway": {
      "main": [
        [{ "node": "Report SMS sent (fallback)", "type": "main", "index": 0 }],
        [{ "node": "Report SMS failed", "type": "main", "index": 0 }]
      ]
    }
  }
}
