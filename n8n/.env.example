# Local n8n for the ERP notifications. Everything is optional: the defaults use the
# mock gateways (npm run mocks) and read the webhook secret from ../backend/.env.

# ERP_API_URL=http://localhost:3000
# N8N_PORT=5678

# Real gateways (see README "Production"); keys go into n8n credentials on `npm run import`
# EMAIL_API_URL=https://api.example-mail.com/v3/messages
# EMAIL_API_KEY=
# SMS_PRIMARY_URL=https://sms-primary.example.com.bd/api/send
# SMS_PRIMARY_KEY=
# SMS_FALLBACK_URL=https://sms-fallback.example.com.bd/api/send
# SMS_FALLBACK_KEY=

# Lead capture (WP31, workflow "ERP lead capture")
# LEAD_FEED_SECRET=            the secret the lead feed (Facebook / an outside form) signs with
# ERP_CRM_CAPTURE_KEY=         ServiceKey <id>.<secret> from POST /service-keys with permissions ["crm.capture"]

# Onboarding / offboarding kits (WP31, workflow "ERP onboarding and offboarding kits")
# OFFICE_KIT_MAILBOX=office@example.com.bd
# ERP_APP_URL=http://localhost:3001

# Bank statement import (WP20, workflow "ERP bank statements")
# BANK_FEED_SECRET=            the secret the bank feed / fetcher signs pushes with
# ERP_BANK_IMPORT_KEY=         ServiceKey <id>.<secret> from POST /service-keys with permissions ["bank.import"]
