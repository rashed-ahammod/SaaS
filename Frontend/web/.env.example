# Where the ERP API (backend) runs. Server-side only: browsers never call it directly,
# so there is no NEXT_PUBLIC_ version of this and there must not be one.
# On Vercel this is the Render address: https://erp-api-xxxx.onrender.com
BACKEND_URL=http://localhost:3000

# The session cookie is HTTPS-only in production. Only for a test on a LAN without HTTPS:
# SESSION_COOKIE_SECURE=false

# Public enquiry form (/enquiry/<form>, no sign-in): each form's company and its service key
# (permission crm.capture). Server-side only; the page never sees the key. One line of JSON:
# ENQUIRY_FORMS={"demo":{"companyId":"<uuid>","serviceKey":"ServiceKey <id>.<secret>","nameEn":"Demo Trading Ltd","nameBn":"ডেমো ট্রেডিং লিমিটেড"}}

# The day the demo is told on, matching DEV_CLOCK in backend/.env (development
# only; leave it out everywhere else). The API is pinned to that day, so the app
# has to agree: otherwise the browser's "today" is a date the API still calls the
# future, and a claim or a correction dated today is refused.
# NEXT_PUBLIC_DEV_CLOCK=2026-10-29T10:30:00+06:00
