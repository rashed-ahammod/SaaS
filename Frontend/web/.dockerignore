# A smaller build context means faster builds. The Dockerfile copies the whole
# directory, so anything listed here is genuinely kept out of the image.
node_modules
.next
out
coverage
test-results
playwright-report
e2e/.auth

# Secrets: BACKEND_URL and ENQUIRY_FORMS are given at run time, never baked in.
.env
.env.*
!.env.example

*.log
*.tsbuildinfo
next-env.d.ts
Dockerfile
.dockerignore
