# ---------------------------------------------------------------------------
# Repo-wide ignores. Each package (backend/, Frontend/web/, n8n/) also has its
# own .gitignore; this file is the safety net for the whole monorepo.
#
# Patterns for build output and local runtime data are ANCHORED to the path
# they belong to ("/backend/storage/", not "storage/"). An unanchored pattern
# matches at every depth, so a plain "storage/" would also hide the source
# directory backend/src/platform/storage/.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/

# Secrets: never commit a real environment file. Only *.env.example is tracked.
.env
.env.*
!.env.example
!.env.*.example
*.pem
secrets/
*credentials*.json

# Build output
/backend/dist/
/Frontend/web/.next/
/Frontend/web/out/
*.tsbuildinfo

# Test and tool output
/backend/coverage/
/backend/test-results/
/Frontend/web/coverage/
/Frontend/web/test-results/
/Frontend/web/playwright-report/

# Local runtime data
/backend/storage/
/backend/backups/
/n8n/.n8n/
*.log
*.pid

# OS and editor
.DS_Store
Thumbs.db
.idea/
