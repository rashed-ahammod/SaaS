# ---------------------------------------------------------------------------
# Environment variables for the ERP API.
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# In staging/production these come from the secret store, never from a file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# --- PostgreSQL -------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=erp_dev
# Database used by the integration tests (created by `npm run db:setup`).
PG_TEST_DATABASE=erp_test

# Superuser login, used ONLY by `npm run db:setup` to create the databases
# and the three roles below. The running app never uses it.
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=change-me

# Role passwords (db:setup creates the roles with these passwords).
#   erp_owner  - owns the tables, runs migrations
#   erp_app    - used by the API; no BYPASSRLS, not the table owner
#   erp_worker - used by background jobs; sees only the outbox/audit tables
PG_OWNER_PASSWORD=change-me-owner
PG_APP_PASSWORD=change-me-app
PG_WORKER_PASSWORD=change-me-worker
# Backups (npm run backup / restore:drill, WP12): read-only role that sees every tenant
PG_BACKUP_PASSWORD=change-me-backup

# --- Security ---------------------------------------------------------------
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# Mandatory 2FA for Admin/System Admin/HR/Accounts and step-up codes (X-OTP-Code)
# for role grants and bank-account changes. Must be true in production.
# Set to false on your own machine to try the API in Postman without an authenticator app.
SECURITY_MFA_ENFORCED=true

# --- Outbox -> n8n ----------------------------------------------------------
# Each event is POSTed to  <OUTBOX_WEBHOOK_BASE_URL>/<event.type>, signed with the secret.
# Leave empty to keep events pending (nothing is sent). With the local n8n (../n8n):
#   OUTBOX_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook/6f1c2b9e-3d4a-4f5b-9c7d-8e0f1a2b3c4d/erp
OUTBOX_WEBHOOK_BASE_URL=
# Long random value (e.g. openssl rand -base64 32); also signs the event callback tokens n8n uses.
OUTBOX_WEBHOOK_SECRET=

# Address of the employee app: links in e-mails, SMS and in-app messages
PUBLIC_APP_URL=http://localhost:3001

# --- Files --------------------------------------------------------------------
# local  a folder on disk (FILE_STORAGE_DIR below). Use it on your own machine, and
#        in production ONLY with a mounted volume and a single API instance: two
#        instances cannot share the folder, and a container without a volume loses
#        every uploaded document on the next deploy.
# s3     any S3-compatible bucket: AWS S3, Cloudflare R2, MinIO on-premise.
#        Required as soon as more than one API instance runs.
FILE_STORAGE_DRIVER=local

# Used when FILE_STORAGE_DRIVER=local. Relative to backend/.
FILE_STORAGE_DIR=storage

# Used when FILE_STORAGE_DRIVER=s3. The bucket must be PRIVATE: these files are
# NID scans, contracts and expense receipts. Give the key only the rights it needs
# (PutObject, GetObject on this bucket), and turn on the provider's encryption at rest.
S3_BUCKET=
# Cloudflare R2: auto     AWS S3: the bucket's region, e.g. ap-southeast-1
S3_REGION=auto
# Empty for AWS S3. R2: https://<account-id>.r2.cloudflarestorage.com
# MinIO: http://minio.internal:9000 (then also S3_FORCE_PATH_STYLE=true)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- AI gateway (WP11) ----------------------------------------------------------
# off       the app runs without AI; the assistant and "Explain" buttons are hidden
# anthropic Claude through the Anthropic API (needs ANTHROPIC_API_KEY or `ant auth login`)
# fake      deterministic stand-in for tests and demos (refused in production)
AI_PROVIDER=off
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# the user waits at most this long for an answer, then sees the normal screens
AI_TIMEOUT_MS=25000
# Release gate: a feature is offered only after `npm run ai:eval` passed for this model and
# prompt version. Always enforced in production; set true to try it elsewhere.
AI_REQUIRE_RELEASE_GATE=false
AI_REQUIRED_PASS_RATE=0.9

# --- Backups (WP12) ---------------------------------------------------------------
# 32 random bytes, base64 (openssl rand -base64 32). Keep it in the secret store AND offline:
# without it no backup can be restored.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=backups
# a second location (another disk / mounted bucket); each backup is copied there
BACKUP_COPY_DIR=

# --- Monitoring (WP12) ------------------------------------------------------------
# Prometheus scrapes GET /metrics with Authorization: Bearer <METRICS_TOKEN> (required in production)
METRICS_TOKEN=
