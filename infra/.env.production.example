# ---------------------------------------------------------------------------
# Settings for docker-compose.prod.yml. Copy to infra/.env and fill in.
#
#   cp .env.production.example .env
#
# infra/.env is gitignored and holds every secret for the deployment. The API
# refuses to start in production when a value is missing, short or a
# placeholder, so a bad file fails immediately instead of silently.
#
# Generate each secret below with (run from backend/):
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"  # JWT_SECRET
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"     # the two *_KEY values
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"  # METRICS_TOKEN
#   node -e "console.log(require('node:crypto').randomBytes(18).toString('base64url'))"  # each password
# ---------------------------------------------------------------------------

# --- The public address of the employee app --------------------------------
# Must be https:// or the API refuses to start (secure cookies, phone
# location). With a Cloudflare tunnel this is the tunnel's public hostname.
PUBLIC_APP_URL=https://erp.example.com

# --- Database --------------------------------------------------------------
PG_DATABASE=erp
# The postgres container's superuser password. Also used once, by db:setup, to
# create the four roles below.
PG_ADMIN_PASSWORD=
# erp_owner  owns the tables and runs migrations
# erp_app    serves the API; no BYPASSRLS, not the table owner
# erp_worker runs the background jobs
# erp_backup reads everything for backups, can change nothing
# At least 16 characters each; 20+ random characters recommended.
PG_OWNER_PASSWORD=
PG_APP_PASSWORD=
PG_WORKER_PASSWORD=
PG_BACKUP_PASSWORD=

# --- Security --------------------------------------------------------------
# At least 32 characters.
JWT_SECRET=
# 32 random bytes, base64.
#
# KEEP AN OFFLINE COPY OF THIS ONE. Without it, every encrypted NID, TIN and
# bank account in the database is unreadable for ever. A copy in this file
# alone is not a backup.
FIELD_ENCRYPTION_KEY=
# At least 32 characters. Prometheus needs it to read GET /metrics.
METRICS_TOKEN=

# --- Backups ---------------------------------------------------------------
# 32 random bytes, base64.
#
# KEEP AN OFFLINE COPY OF THIS ONE TOO. Without it no backup can be restored.
BACKUP_ENCRYPTION_KEY=

# --- Cloudflare tunnel (optional, for the "tunnel" profile) ----------------
# Zero Trust -> Networks -> Tunnels -> create a tunnel, point its public
# hostname at http://web:3001, then paste the connector token here.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Optional --------------------------------------------------------------
# off | anthropic. "off" hides the assistant and needs no key.
AI_PROVIDER=off
ANTHROPIC_API_KEY=

# n8n for e-mail and SMS. Leave empty and events stay pending; in-app
# notifications still work. n8n belongs on the private network only.
OUTBOX_WEBHOOK_BASE_URL=
OUTBOX_WEBHOOK_SECRET=

# Public enquiry form, one line of JSON. See Frontend/web/.env.example.
ENQUIRY_FORMS=
